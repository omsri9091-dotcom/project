# Server Port
PORT=5000

# MongoDB URI (Leave as 'memory' or 'mongodb://localhost:27017/adexa_db' - auto in-memory fallback enabled!)
MONGODB_URI=mongodb://localhost:27017/adexa_db

# JWT Secret
JWT_SECRET=adexa_ai_secure_jwt_secret_key_2026_production

# Python AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Optional External LLM Integration (OpenAI or Gemini for Academic Assistant)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Demo Admin Initial Password
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_STUDENT_PASSWORD=Student@12345
